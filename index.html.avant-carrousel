<script>
(function(){
"use strict";


var R = matchMedia('(prefers-reduced-motion: reduce)').matches;
var fine = matchMedia('(hover:hover) and (pointer:fine)').matches;

/* le chapo du hero, mot par mot, apres le passage du rideau */
(function(){
  var el = document.querySelector('.hero-lede');
  if (!el) return;
  if (R){ el.classList.add('vu'); return; }
  var mots = el.textContent.split(/(\s+)/), frag = document.createDocumentFragment(), n = 0;
  mots.forEach(function(m){
    if (!m) return;
    if (/^\s+$/.test(m)){ frag.appendChild(document.createTextNode(m)); return; }
    var sp = document.createElement('span');
    sp.className = 'mot'; sp.textContent = m;
    sp.style.transitionDelay = (0.025 * n) + 's';
    n++;
    frag.appendChild(sp);
  });
  el.textContent = '';
  el.appendChild(frag);
  setTimeout(function(){ el.classList.add('vu'); }, 1000);
})();

/* titre lettre par lettre */
(function(){
  var h = document.getElementById('h1'), mot = 'Irmao';
  for (var i = 0; i < mot.length; i++){
    var s = document.createElement('span');
    s.textContent = mot[i];
    s.style.animationDelay = (0.15 + 0.06 * i) + 's';
    h.appendChild(s);
  }
})();

/* défilement à inertie (le « ralentissement ») */
var target = window.scrollY, cur = target, running = false;
function maxY(){ return document.documentElement.scrollHeight - innerHeight; }
if (fine && !R){
  addEventListener('wheel', function(e){
    if (document.body.classList.contains('nav-open')) return;
    e.preventDefault();
    var d = e.deltaY * (e.deltaMode === 1 ? 18 : e.deltaMode === 2 ? innerHeight : 1);
    target = Math.max(0, Math.min(maxY(), target + d));
    if (!running){ running = true; requestAnimationFrame(glide); }
  }, {passive:false});

  addEventListener('scroll', function(){ if (!running) target = cur = window.scrollY; }, {passive:true});
  addEventListener('resize', function(){ target = cur = window.scrollY; });

  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click', function(e){
      var el = document.querySelector(a.getAttribute('href'));
      if (!el) return;
      e.preventDefault();
      document.body.classList.remove('nav-open');
      target = Math.max(0, Math.min(maxY(), el.getBoundingClientRect().top + window.scrollY - 10));
      if (!running){ running = true; requestAnimationFrame(glide); }
    });
  });
}
function glide(){
  cur += (target - cur) * 0.082;
  if (Math.abs(target - cur) < 0.4){ cur = target; running = false; }
  window.scrollTo(0, cur);
  if (running) requestAnimationFrame(glide);
}

/* Scene pilotee par le defilement : la table qui se dresse.
   Les assiettes n'defilent pas en carrousel, elles arrivent une a une depuis les bords
   de l'ecran et viennent se poser en cercle autour de la nappe. Chacune a sa fenetre de
   temps propre, decalee, donc le service se fait vraiment au fur et a mesure. */
var track = document.getElementById('track'),
    stage = document.getElementById('stage'),
    nappe = document.getElementById('nappe'),
    plates = [].slice.call(document.querySelectorAll('.plate')),
    pDesc = document.getElementById('pDesc'),
    dernier = -1;

/* d'ou vient chaque assiette : un cote de l'ecran, et le tour de table ou elle se pose */
var ARRIVEE = [
  { bord: [ 0.00, -1.35], angle: -90 },
  { bord: [ 1.45, -0.35], angle: -18 },
  { bord: [ 1.15,  1.20], angle:  54 },
  { bord: [-1.15,  1.20], angle: 126 },
  { bord: [-1.45, -0.35], angle: 198 }
];

function melange(a, b, t){ return a + (b - a) * t; }
function palier(v, a, b){ v = (v - a) / (b - a); return v < 0 ? 0 : (v > 1 ? 1 : v); }
function poser(t){ return 1 - Math.pow(1 - t, 3); }          /* arrivee amortie */

function scene(){
  var r = track.getBoundingClientRect(),
      course = track.offsetHeight - innerHeight,
      p = Math.max(0, Math.min(1, -r.top / course)),
      n = plates.length,
      W = stage.clientWidth, H = stage.clientHeight,
      Rx = W * 0.315, Ry = H * 0.285,
      pose = 0;

  /* la nappe se pose la premiere, et respire ensuite */
  var vn = palier(p, 0, .12);
  nappe.style.opacity = vn.toFixed(3);
  nappe.style.transform = 'translate(-50%,-50%) scale(' + (0.82 + 0.18 * poser(vn)).toFixed(3) + ')';

  for (var i = 0; i < n; i++){
    var a = ARRIVEE[i],
        debut = 0.10 + i * 0.155,
        q = poser(palier(p, debut, debut + 0.30)),
        rad = a.angle * Math.PI / 180,
        xf = Math.cos(rad) * Rx, yf = Math.sin(rad) * Ry,
        xd = a.bord[0] * W * 0.62, yd = a.bord[1] * H * 0.62,
        x = melange(xd, xf, q), y = melange(yd, yf, q),
        rot = melange(i % 2 ? 26 : -26, 0, q),
        ech = melange(0.62, 1, q);

    if (q > 0.02) pose = i + 1;
    var el = plates[i];
    el.style.transform = 'translate(-50%,-50%) translate(' + x.toFixed(1) + 'px,' + y.toFixed(1) +
      'px) rotate(' + rot.toFixed(1) + 'deg) scale(' + ech.toFixed(3) + ')';
    el.style.opacity = Math.min(1, q * 2.4).toFixed(3);
    el.style.zIndex = String(10 + i);
    el.querySelector('figcaption').style.opacity = palier(q, .55, 1).toFixed(3);
  }

  /* le centre porte la derniere assiette posee */
  var idx = Math.max(0, pose - 1);
  if (idx !== dernier){
    dernier = idx;
    pDesc.textContent = plates[idx].dataset.desc;
    if (!R) pDesc.animate([{opacity:0, transform:'translateY(8px)'},{opacity:1, transform:'none'}],
      {duration:460, easing:'cubic-bezier(.22,.61,.36,1)'});
  }
}

/* parallaxe des cadres + état du header */
var pars = [].slice.call(document.querySelectorAll('[data-par]'));
function frames(){
  document.body.classList.toggle('scrolled', window.scrollY > 40);
  document.querySelector('.backdrop').style.transform =
    'translate3d(0,' + (-window.scrollY * 0.06).toFixed(1) + 'px,0)';
  for (var i = 0; i < pars.length; i++){
    var el = pars[i], b = el.getBoundingClientRect();
    if (b.bottom < -200 || b.top > innerHeight + 200) continue;
    var q = (b.top + b.height / 2 - innerHeight / 2) / innerHeight;
    el.style.transform = 'translateY(' + (q * -26).toFixed(1) + 'px)';
  }
}

/* dérive du fond + boucle principale */
var blobs = [].slice.call(document.querySelectorAll('.backdrop b'));
var t0 = performance.now();
(function tick(t){
  scene();
  frames();
  if (!R){
    var s = (t - t0) / 1000;
    for (var i = 0; i < blobs.length; i++){
      blobs[i].style.translate = (Math.sin(s * 0.07 + i * 1.7) * 26).toFixed(1) + 'px ' +
                                 (Math.cos(s * 0.055 + i * 2.3) * 20).toFixed(1) + 'px';
    }
  }
  requestAnimationFrame(tick);
})(t0);

/* cartes du hero : parallaxe curseur */
if (fine && !R){
  var floats = [].slice.call(document.querySelectorAll('.float'));
  var tx = 0, ty = 0, cx = 0, cy = 0, fraf = null;
  addEventListener('pointermove', function(e){
    tx = e.clientX / innerWidth - 0.5;
    ty = e.clientY / innerHeight - 0.5;
    if (!fraf) fraf = requestAnimationFrame(follow);
  }, {passive:true});
  function follow(){
    cx += (tx - cx) * 0.075;
    cy += (ty - cy) * 0.075;
    for (var i = 0; i < floats.length; i++){
      var f = floats[i], d = +f.dataset.depth;
      f.style.transform = 'translate3d(' + (cx * d).toFixed(1) + 'px,' + (cy * d * 0.72).toFixed(1) +
        'px,0) rotate(' + (cx * d * 0.06).toFixed(2) + 'deg) scale(' + (1 + Math.abs(cx) * 0.05).toFixed(3) + ')';
    }
    fraf = (Math.abs(tx - cx) > 0.0004 || Math.abs(ty - cy) > 0.0004) ? requestAnimationFrame(follow) : null;
  }
}

/* aimant sur les disques de contact */
if (fine && !R){
  document.querySelectorAll('.orb').forEach(function(o){
    var b = o.querySelector('.b');
    o.addEventListener('pointermove', function(e){
      var r = o.getBoundingClientRect();
      b.style.transform = 'translate(' + ((e.clientX - r.left - r.width / 2) * 0.28).toFixed(1) + 'px,' +
                          ((e.clientY - r.top - r.height / 2) * 0.28).toFixed(1) + 'px) scale(1.06)';
    });
    o.addEventListener('pointerleave', function(){ b.style.transform = ''; });
  });
}

/* menu, filtres, statut, marquee */
var burger = document.getElementById('burger');
burger.addEventListener('click', function(){
  var open = document.body.classList.toggle('nav-open');
  burger.setAttribute('aria-expanded', open);
  burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
});
addEventListener('keydown', function(e){
  if (e.key === 'Escape' && document.body.classList.contains('nav-open')) burger.click();
});

var fb = document.querySelectorAll('#filters button'), dishes = document.querySelectorAll('#grid .dish');
fb.forEach(function(b){
  b.addEventListener('click', function(){
    fb.forEach(function(o){ o.setAttribute('aria-pressed','false'); });
    b.setAttribute('aria-pressed','true');
    var c = b.dataset.cat, k = 0;
    dishes.forEach(function(d){
      var show = (c === 'all' || d.dataset.cat === c);
      d.classList.toggle('hide', !show);
      if (show && !R){
        d.animate([{opacity:0, transform:'translateY(18px) scale(.98)'},{opacity:1, transform:'none'}],
          {duration:520, delay: Math.min(k * 45, 400), easing:'cubic-bezier(.22,.61,.36,1)', fill:'backwards'});
        k++;
      }
    });
  });
});

(function(){
  var now = new Date(), d = now.getDay(), h = now.getHours();
  var ouvert = ((d >= 2 && d <= 6) && h >= 18) || ((d === 0 || (d >= 3 && d <= 6)) && h < 1);
  var el = document.getElementById('statut'), sub = document.getElementById('statut-sub');
  var jours = ['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
  el.firstChild.className = 'dot' + (ouvert ? ' on' : '');
  document.getElementById('statut-etat').textContent = ouvert ? 'Ouvert' : 'Fermé';
  if (ouvert) sub.textContent = "Le service continue jusqu'à 1h";
  else if (d === 1 || (d === 0 && h >= 1)) sub.textContent = 'Réouverture mardi à 18h';
  else if (h < 18) sub.textContent = 'Ouvre ce ' + jours[d] + ' à 18h';
  else sub.textContent = 'Réouverture demain à 18h';
  var jour = (h < 1) ? (d + 6) % 7 : d;
  var li = document.querySelector('#hours li[data-d="' + jour + '"]');
  if (li) li.classList.add('today');
})();

document.querySelectorAll('a[href="mobile.html"]').forEach(function(a){
  a.addEventListener('click', function(){ try{ sessionStorage.setItem('irmao-vue','mobile'); }catch(e){} });
});

var run = document.getElementById('run');
run.innerHTML += run.innerHTML;
})();
</script>
