<script>
/* Rideau d'entree : l'ecran est marron, puis un trait epais descend, remonte et boucle
   sur lui-meme en cercle avant de se resorber dans le coin bas-droit.
   Le trait est un anneau ancre par un point de son epaisseur au coin bas-droit : tant
   qu'il est enorme l'ecran est pris dedans, puis son centre descend en diagonale, passe
   par le milieu de l'ecran ou la boucle se lit comme un cercle, et finit dans le coin.
   Trace en SVG et non en texte agrandi : a l'echelle x78, un glyphe HTML depasse la
   taille de texture du compositeur et sort en aplat noir.
   Le voile est cree et retire par ce meme script : sans JavaScript il n'existe pas. */
(function(){
  try{
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var d = document, NS = 'http://www.w3.org/2000/svg';
    var svg = d.createElementNS(NS, 'svg');
    svg.setAttribute('class', 'rideau');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('preserveAspectRatio', 'none');
    var g = d.createElementNS(NS, 'g');
    var forme = d.createElementNS(NS, 'path');
    /* un anneau : ellipse pleine, moins sa contreforme, comme le o de Irmao */
    forme.setAttribute('fill-rule', 'evenodd');
    forme.setAttribute('fill', getComputedStyle(d.documentElement).getPropertyValue('--ink').trim() || '#2A1A12');
    forme.setAttribute('d',
      'M -100,0 a 100,113 0 1,0 200,0 a 100,113 0 1,0 -200,0 ' +
      'M -32,2 a 32,37 0 1,0 64,0 a 32,37 0 1,0 -64,0');
    g.appendChild(forme); svg.appendChild(g); d.body.appendChild(svg);
    d.body.classList.add('rideau-haut');

    /* Point de l'anneau colle au coin bas-droit. Pris dans le fut inferieur droit :
       la contreforme balaie alors l'ecran en s'ouvrant, comme sur la video. */
    var ANCRE_X = 55, ANCRE_Y = 63;
    var duree = 1500, retard = 120, t0 = null, hautRetire = false;

    function cadre(){
      svg.setAttribute('viewBox', '0 0 ' + innerWidth + ' ' + innerHeight);
    }
    function fini(){
      d.body.classList.remove('rideau-haut');
      window.removeEventListener('resize', cadre);
      if (svg.parentNode) svg.parentNode.removeChild(svg);
    }
    /* Le rythme. Une table de paliers interpolee en smoothstep remet la vitesse a zero
       a chaque noeud : la boucle s'arretait quatre fois en route, c'est ce qui hachait
       le mouvement. Ici une seule courbe continue, sans noeud, donc sans a-coup.
       Un zoom se lit en proportions : c'est le logarithme de l'echelle qui doit filer
       regulierement, d'ou la decroissance exponentielle. L'exposant 2,2 retient la
       boucle au depart, comme sur la video, puis la laisse partir sans jamais caler.
       ECH0 est l'echelle ou l'epaisseur du trait couvre tout l'ecran ; elle suit la
       diagonale de la fenetre, le rideau est donc plein quel que soit le format. */
    var ECH0 = 0, PENTE = 0;
    function echelle(p){
      return ECH0 * Math.exp(-PENTE * Math.pow(p, 2.2));
    }

    /* Quand rendre ses couleurs a la barre du haut : au dernier instant ou son milieu
       est encore sur le marron. Calcule sur la trajectoire, pas au juge, sinon la barre
       repasse en sombre pendant que la boucle balaie le haut de l'ecran. */
    var RAD = -8 * Math.PI / 180, BASCULE = 1;
    function surLeMarron(s, W, H){
      var dx = (W / 2 - W) / s, dy = (46 - H) / s;
      var c = Math.cos(RAD), n = Math.sin(RAD);
      var qx = dx * c + dy * n + ANCRE_X, qy = -dx * n + dy * c + ANCRE_Y;
      return (qx/100)*(qx/100) + (qy/113)*(qy/113) <= 1 &&
             (qx/32)*(qx/32) + ((qy-2)/37)*((qy-2)/37) > 1;
    }
    /* Reglage a la premiere image : dans le corps du document innerWidth vaut encore
       zero, et une echelle calculee la donnerait un scale(NaN) et pas de rideau. */
    function calibrer(){
      var W = innerWidth || d.documentElement.clientWidth || 1280;
      var H = innerHeight || d.documentElement.clientHeight || 800;
      ECH0 = Math.sqrt(W * W + H * H) / 45;
      PENTE = Math.log(ECH0 / 0.05);
      BASCULE = 0;
      for (var i = 0; i <= 120; i++) if (surLeMarron(echelle(i / 120), W, H)) BASCULE = i / 120;
    }
    function pas(t){
      if (t0 === null){ t0 = t; cadre(); calibrer(); }
      var p = (t - t0 - retard) / duree;
      p = p < 0 ? 0 : (p > 1 ? 1 : p);
      var s = echelle(p);
      g.setAttribute('transform',
        'translate(' + innerWidth + ',' + innerHeight + ') scale(' + s.toFixed(4) +
        ') rotate(-8) translate(' + (-ANCRE_X) + ',' + (-ANCRE_Y) + ')');
      if (!hautRetire && p > BASCULE){ hautRetire = true; d.body.classList.remove('rideau-haut'); }
      if (p < 1) requestAnimationFrame(pas); else fini();
    }
    cadre();
    window.addEventListener('resize', cadre);
    requestAnimationFrame(pas);
    setTimeout(fini, 3200);
  }catch(e){}
})();
</script>

