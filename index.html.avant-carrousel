<script>
/* Aiguillage vers la version mobile.
   Deux garde-fous : un vrai écran tactile étroit (pas une fenêtre de bureau rétrécie),
   et le choix manuel de l'internaute, qui coupe l'aiguillage pour la session. */
(function(){try{
  if (sessionStorage.getItem('irmao-vue')) return;
  var etroit = (window.innerWidth || 9999) <= 760;
  var tactile = window.matchMedia && matchMedia('(pointer: coarse)').matches;
  if (etroit && tactile) location.replace('mobile.html');
}catch(e){}})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
